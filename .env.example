# ===== 模型（B1 使用，勿写进代码；key 只填 .env，勿提交）=====
# 已适配百炼 token-plan 专属端点：sk-sp- 头的 key 只能用此端点，配公共 dashscope 端点会 401
OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.8-max

# 采样参数（复跑一致性：演示时固定低温度）
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_CONCURRENCY=2

# ===== 服务 =====
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# 单次评审：最大规划轮次 / 单步超时(ms) / 重试上限
HARNESS_MAX_ROUNDS=3
HARNESS_STEP_TIMEOUT_MS=90000
HARNESS_RETRY=1

# ===== OCR（内网自部署 VL 模型，vLLM OpenAI 兼容端点；开发机临时可指向百炼云验证）=====
OCR_ENABLED=true
# 例：http://内网GPU:8000/v1
OCR_BASE_URL=
# OCR 视觉模型名：必须与 vLLM 启动时 --served-model-name 一致（暂无内网 GPU 时先 7B 起步）
OCR_MODEL=Qwen2.5-VL-7B-Instruct
# vLLM 通常无鉴权；内网网关要 key 才填，代码自动带 Authorization 头
OCR_API_KEY=
OCR_CONCURRENCY=2
OCR_PAGE_TIMEOUT_MS=120000
OCR_MAX_TOKENS=2048
# PDF 页"无文本层"判定：整页文本字符数低于此值 → 渲染该页走 OCR
OCR_MIN_TEXT_CHARS=10
# PDF 渲染图片缩放倍数（2 = 2x，清晰度/体积折中）
OCR_PDF_RENDER_SCALE=2

# ===== 文档与规则 =====
WORKSPACE_DIR=./workspace
RULES_FILE=docs/rules清单.md
RULE_SET_ID=default

# ===== 前端（Vite）=====
# 指向 mock: http://localhost:8787 ; 指向真实后端: http://localhost:8080
VITE_API_BASE=http://localhost:8787
